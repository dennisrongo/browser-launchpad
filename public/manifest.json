{
  "manifest_version": 3,
  "name": "Browser Launchpad",
  "version": "1.3.0",
  "description": "A customizable, widget-based dashboard for your new tab page",
  "author": "Dennis Rongo",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Browser Launchpad"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "1060415387480-fe5eme78v2hrdk09129eii6i7f8u5vas.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events.readonly",
      "https://www.googleapis.com/auth/tasks"
    ]
  },
  "permissions": [
    "storage",
    "identity",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://* http://* https://tasks.googleapis.com; img-src 'self' https://* http://* data:"
  }
}
